# ==============================================================================
# Git Ignore — FallaJobs Project (Root & Workspaces)
# ==============================================================================

# ── 1. Environnements, Clés & Secrets (STRICTEMENT CONFIDENTIEL) ───────────────
.env
.env.*
!.env.example
!.env.*.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
!backend/.env.*.example
dashboard/.env
dashboard/.env.*
!dashboard/.env.example

# Clés de sécurité, certificats & identifiants
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
client_secret*.json
credentials.json
ressources/clé nokash/
ressources/**/clés.txt
**/clé*
**/cle*
/workflows/credentials/

# ── 2. Java / Spring Boot (Backend) ────────────────────────────────────────────
target/
**/target/
backend/target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.jar

# Bases de données locales, dumps & H2
*.sql.gz
*.dump
*.dmp
backup.sql
**/backup.sql
backend/backup.sql
*.h2.db
*.mv.db
*.trace.db
*.sqlite
*.sqlite3
*.db

# ── 3. Angular / Node / TypeScript (Frontend) ─────────────────────────────────
node_modules/
**/node_modules/
dashboard/node_modules/

# Compilation & caches
dist/
**/dist/
dashboard/dist/
.angular/
**/.angular/
dashboard/.angular/
.angular/cache/
**/.angular/cache/
out-tsc/
**/out-tsc/
dashboard/out-tsc/
tmp/
**/tmp/
dashboard/tmp/
.sass-cache/
.parcel-cache/
.turbo/
.cache/
typings/
connect.lock

# Rapports de couverture de tests
coverage/
**/coverage/
dashboard/coverage/
.nyc_output/

# ── 4. Logs & Sorties Temporaires ──────────────────────────────────────────────
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
libpeerconnection.log
testem.log
ng-serve.log
build-output.txt
doopinet.html

