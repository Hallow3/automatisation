local.file "docker_targets" {
  filename = "/etc/alloy/targets/docker-log-targets.json"
  detector = "poll"
  poll_frequency = "30s"
}

local.file_match "docker_logs" {
  path_targets = encoding.from_json(local.file.docker_targets.content)
}

loki.source.file "docker_logs" {
  targets    = local.file_match.docker_logs.targets
  forward_to = [loki.process.docker_logs.receiver]
  tail_from_end = true
}

loki.process "docker_logs" {
  stage.json {
    expressions = {
      output = "log",
      stream = "stream",
    }
  }
  stage.labels {
    values = {
      stream = "stream",
    }
  }
  stage.output {
    source = "output"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://fallajobs-loki:3100/loki/api/v1/push"
  }
}
