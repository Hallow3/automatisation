{
  "uid": "fallajobs-prod",
  "title": "FallaJobs · Production",
  "tags": ["fallajobs", "production"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "annotations": { "list": [] },
  "panels": [
    { "id": 1, "type": "stat", "title": "Utilisateurs inscrits", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "fallajobs_users_registered", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" } },
    { "id": 2, "type": "stat", "title": "Comptes vérifiés", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "fallajobs_users_verified", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" } },
    { "id": 3, "type": "stat", "title": "Inscriptions réussies · 24 h", "description": "Réponse HTTP 2xx de l’API d’inscription.", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum(increase(fallajobs_registration_requests_total{outcome=\"success\"}[24h])) or vector(0)", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" } },
    { "id": 4, "type": "stat", "title": "Inscriptions en échec · 24 h", "description": "Réponses HTTP 4xx/5xx de l’API d’inscription.", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum(increase(fallajobs_registration_requests_total{outcome=\"failure\"}[24h])) or vector(0)", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" } },
    { "id": 5, "type": "timeseries", "title": "Taux de réussite des inscriptions · 24 h", "description": "Part des réponses 2xx sur les requêtes reçues par l’API d’inscription.", "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "100 * sum(increase(fallajobs_registration_requests_total{outcome=\"success\"}[24h])) / clamp_min(sum(increase(fallajobs_registration_requests_total[24h])), 1)", "legendFormat": "Réussite %", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }, "options": { "legend": { "showLegend": true }, "tooltip": { "mode": "single" } } },
    { "id": 6, "type": "table", "title": "État des conteneurs", "description": "État relevé sur l’hôte toutes les 30 secondes, sans accès au socket Docker depuis Grafana ou les exporters.", "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "fallajobs_container_state", "format": "table", "instant": true, "refId": "A" }], "fieldConfig": { "defaults": { "custom": { "align": "auto", "displayMode": "auto" } }, "overrides": [] }, "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } } },
    { "id": 8, "type": "stat", "title": "Entretiens terminés · 24 h", "description": "Sessions terminées avec la raison COMPLETED en base de données.", "gridPos": { "x": 0, "y": 13, "w": 6, "h": 5 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "fallajobs_interview_ended_24h{reason=\"COMPLETED\"}", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" } },
    { "id": 9, "type": "stat", "title": "Échecs techniques entretiens · 24 h", "description": "Indisponibilité IA et sessions interrompues par absence de heartbeat. Les arrêts volontaires et les crédits épuisés sont exclus.", "gridPos": { "x": 6, "y": 13, "w": 6, "h": 5 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum(fallajobs_interview_ended_24h{reason=~\"AI_UNAVAILABLE|HEARTBEAT_TIMEOUT|ORPHAN_TIMEOUT\"}) or vector(0)", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" } },
    { "id": 10, "type": "stat", "title": "Taux d'échec technique des entretiens · 24 h", "description": "Échecs techniques / (entretiens terminés + échecs techniques). Les sessions actives, les arrêts volontaires et les crédits épuisés sont exclus.", "gridPos": { "x": 12, "y": 13, "w": 6, "h": 5 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "100 * (sum(fallajobs_interview_ended_24h{reason=~\"AI_UNAVAILABLE|HEARTBEAT_TIMEOUT|ORPHAN_TIMEOUT\"}) or vector(0)) / clamp_min(sum(fallajobs_interview_ended_24h{reason=~\"COMPLETED|AI_UNAVAILABLE|HEARTBEAT_TIMEOUT|ORPHAN_TIMEOUT\"}), 1)", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" } },
    { "id": 11, "type": "stat", "title": "Arrêts utilisateur / crédits · 24 h", "description": "Sessions arrêtées volontairement ou faute de crédits, exclues du taux d'échec technique.", "gridPos": { "x": 18, "y": 13, "w": 6, "h": 5 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum(fallajobs_interview_ended_24h{reason=~\"USER_HANGUP|CREDIT_LIMIT_REACHED\"}) or vector(0)", "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" } },
    { "id": 12, "type": "table", "title": "Causes récurrentes des interruptions · 24 h", "description": "Raisons de fin persistées en base ; permet de distinguer IA, timeout, utilisateur et crédits.", "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "fallajobs_interview_ended_24h{reason!=\"COMPLETED\"} > 0", "format": "table", "instant": true, "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "showHeader": true, "cellHeight": "sm" } },
    { "id": 13, "type": "table", "title": "Routes les plus accédées", "description": "Requêtes HTTP du backend sur la plage de temps sélectionnée ; URI normalisées par Spring MVC.", "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "topk(10, sum by (uri, method) (increase(http_server_requests_seconds_count{uri!~\"/actuator.*|UNKNOWN|NOT_FOUND\"}[$__range])))", "format": "table", "instant": true, "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "showHeader": true, "cellHeight": "sm" } },
    { "id": 14, "type": "table", "title": "Routes avec le plus d'erreurs HTTP", "description": "Nombre de réponses 4xx et 5xx par route et code HTTP sur la plage sélectionnée.", "gridPos": { "x": 0, "y": 26, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "topk(10, sum by (uri, method, status) (increase(http_server_requests_seconds_count{status=~\"4..|5..\",uri!~\"/actuator.*|UNKNOWN|NOT_FOUND\"}[$__range])))", "format": "table", "instant": true, "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "showHeader": true, "cellHeight": "sm" } },
    { "id": 15, "type": "table", "title": "Taux d'erreur 5xx par route", "description": "Part des réponses 5xx par route. Les 4xx sont consultables dans la table voisine.", "gridPos": { "x": 12, "y": 26, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "topk(10, 100 * sum by (uri, method) (increase(http_server_requests_seconds_count{status=~\"5..\",uri!~\"/actuator.*|UNKNOWN|NOT_FOUND\"}[$__range])) / clamp_min(sum by (uri, method) (increase(http_server_requests_seconds_count{uri!~\"/actuator.*|UNKNOWN|NOT_FOUND\"}[$__range])), 1))", "format": "table", "instant": true, "refId": "A" }], "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }, "options": { "showHeader": true, "cellHeight": "sm" } },
    { "id": 7, "type": "logs", "title": "Journaux par service", "description": "Sélectionnez un service dans le filtre en haut du dashboard. Les logs sont conservés sept jours.", "datasource": { "type": "loki", "uid": "loki" }, "gridPos": { "x": 0, "y": 34, "w": 24, "h": 11 }, "targets": [{ "expr": "{job=\"docker\",service=~\"$service\"}", "refId": "A" }], "options": { "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none" } },
    { "id": 16, "type": "table", "title": "Erreurs signalées par le navigateur", "description": "Catégories fixes envoyées par l'application pendant un entretien ; compteurs depuis le dernier redémarrage du backend, sur la plage sélectionnée. Aucun contenu d'entretien n'est envoyé.", "gridPos": { "x": 0, "y": 45, "w": 24, "h": 7 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [{ "expr": "sum by (code) (increase(fallajobs_interview_client_errors_total[$__range])) > 0", "format": "table", "instant": true, "refId": "A" }], "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }, "options": { "showHeader": true, "cellHeight": "sm" } }
  ],
  "templating": { "list": [{ "name": "service", "label": "Service", "type": "query", "datasource": { "type": "loki", "uid": "loki" }, "query": "label_values({job=\"docker\"}, service)", "refresh": 2, "includeAll": true, "allValue": ".*", "multi": true, "current": { "text": "All", "value": "$__all" } }] },
  "links": []
}
