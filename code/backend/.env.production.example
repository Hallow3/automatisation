# ==============================================================================
# GetJob AI Backend - Configuration de Production (.env)
# ==============================================================================
# INSTRUCTIONS :
# 1. Copier ce fichier sous le nom .env sur le serveur de production :
#    cp .env.production.example .env
# 2. Remplacer impérativement toutes les valeurs 'change-moi' ou vides.
# 3. Ne JAMAIS committer de fichier .env contenant de vrais secrets.
# ==============================================================================

# --- Serveur & Reverse Proxy ---
# Port d'écoute interne du container / process Spring Boot
SERVER_PORT=8081

# --- Base de données MySQL (Production) ---
DB_HOST=mysql-prod.internal.domain
DB_PORT=3306
DB_NAME=emploi
DB_USERNAME=getjob_app
DB_PASSWORD=change-moi-mot-de-passe-db-securise

# --- Sécurité & Authentification JWT ---
# Générer une clé secrète robuste (256 bits minimum) via :
# openssl rand -base64 32
JWT_SECRET=change-moi-cle-secrete-32-chars-minimum-base64
# IMPORTANT : En production HTTPS, JWT_COOKIE_SECURE DOIT être à true
JWT_COOKIE_SECURE=true
# Durée de validité du token en ms (ex: 86400000 = 24 heures)
JWT_EXPIRATION_MS=86400000

# --- Domaines & CORS (Production HTTPS) ---
# Origines autorisées séparées par une virgule (ex: https://app.getjobai.com)
CORS_ALLOWED_ORIGINS=https://app.getjobai.com
# URL racine du frontend (utilisée pour composer les liens de validation d'email et de reset mot de passe)
FRONTEND_URL=https://app.getjobai.com

# --- Google OAuth2 (Google Sign-In) ---
# Client ID créé dans la console Google Cloud avec l'URL de prod en origine autorisée
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# --- Envoi d'E-mails (SMTP Gmail / Transactionnel) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-adresse@gmail.com
# Mot de passe d'application Gmail généré depuis le compte Google (16 caractères)
MAIL_PASSWORD=change-moi-mot-de-passe-application-gmail
MAIL_FROM=GetJob AI <noreply@getjobai.com>

# --- Intelligence Artificielle Google Gemini (Live 3.1 & Flash 2.0) ---
# Pool de clés API séparées par une virgule (rotation round-robin et failover automatique)
GEMINI_API_KEYS=AQ.Ab8RN6...,AQ.Ab8RN6...
# Modèle Gemini Live configuré pour les sessions vocales
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Modèle Gemini pour génération structurée et analyse multimodale de CV
GEMINI_MODEL=gemini-2.0-flash

# --- Passerelle de Paiement NotchPay (Production Mobile Money & Carte) ---
NOTCHPAY_PUBLIC_KEY=pk.live_xxxxxxxxxxxx
NOTCHPAY_PRIVATE_KEY=sk.live_xxxxxxxxxxxx
NOTCHPAY_WEBHOOK_SECRET=change-moi-secret-webhook-notchpay
NOTCHPAY_BASE_URL=https://api.notchpay.co
PAYMENT_RETURN_URL=https://app.getjobai.com/cv-builder
WHATSAPP_SUPPORT_PHONE=237698765588

# --- Logs & Monitoring ---
LOG_LEVEL_APP=INFO
