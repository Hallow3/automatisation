# ==============================================================================
# Backend GetJob - Variables d'environnement (copier vers .env et remplir)
# NE JAMAIS committer le fichier .env réel
# ==============================================================================

# --- Base de données ---
DB_HOST=localhost
DB_PORT=3308
DB_NAME=emploi
DB_USERNAME=root
DB_PASSWORD=change-moi

# --- Sécurité JWT ---
# Générer avec: openssl rand -base64 32
JWT_SECRET=change-moi-32-chars-minimum-256-bits
JWT_COOKIE_SECURE=false
JWT_EXPIRATION_MS=86400000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# --- Frontend ---
FRONTEND_URL=http://localhost:4200

# --- Google OAuth ---
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# --- Mail (Gmail SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=GetJob AI <noreply@getjobai.com>

# --- Logs ---
LOG_LEVEL_APP=INFO

# --- IA Gemini Live & Flash ---
# Pool de clés séparées par virgule (round-robin failover)
GEMINI_API_KEYS=AQ.key1,AQ.key2
GEMINI_API_KEY=AQ.key1
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_MODEL=gemini-2.0-flash

# --- Passerelle de Paiement NotchPay & Fallback WhatsApp ---
NOTCHPAY_PUBLIC_KEY=pk.live_xxxxxxxx
NOTCHPAY_PRIVATE_KEY=sk.live_xxxxxxxx
NOTCHPAY_WEBHOOK_SECRET=votre_secret_webhook_notchpay
NOTCHPAY_BASE_URL=https://api.notchpay.co
PAYMENT_RETURN_URL=http://localhost:4200/cv-builder
WHATSAPP_SUPPORT_PHONE=237698765588

# --- IA OpenAI (optionnel) ---
OPENAI_API_KEY=sk-...

