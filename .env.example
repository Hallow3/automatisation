# ==============================================================================
# Fichier d'exemple - copier vers .env et remplir les valeurs réelles
# .env est ignoré par git, .env.example est committé
# ==============================================================================

# --- n8n ---
N8N_ENCRYPTION_KEY=change-moi-32-chars-minimum
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-moi

# --- VPS ---
VPS_IP=

# --- Base de données MySQL (partagée VPS + backend) ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
DB_HOST=localhost
DB_PORT=3308
DB_NAME=emploi
DB_USERNAME=root
DB_PASSWORD=

# --- Backend GetJob (voir code/backend/.env.example pour détail complet) ---
JWT_SECRET=change-moi-32-chars-minimum-256-bits
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=JobPilot <noreply@getjobai.com>
GEMINI_API_KEYS=AIza...
GEMINI_API_KEY=AIza...
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001
OPENAI_API_KEY=sk-...

# --- n8n Variables (Settings > Variables dans l'UI n8n) ---
UNSPLASH_ACCESS_KEY=
SHEET_NAME=calendrier
GOOGLE_SHEET_ID=
LINKEDIN_PERSON_URN=
GROQ_MODEL=llama-3.3-70b-versatile
